{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "claudeMdExcludes": [
    "**/claude-cli-agents-workspace/workspace/**",
    "**/claude-cli-agents-workspace/tmp/**",
    "**/claude-cli-agents-workspace/.claude/worktrees/*/workspace/**",
    "**/claude-cli-agents-workspace/.claude/worktrees/*/tmp/**"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"$CLAUDE_PROJECT_DIR/tests/caw-session-index.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I -B \"$CLAUDE_PROJECT_DIR/tests/caw-language.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(/tmp/work/**)",
      "Bash(bash tests/caw-work.sh *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Edit(/.git/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(bash tests/caw-work.sh push * --accept-terms*)",
      "Bash(bash tests/caw-work.sh *--accept-terms*)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)"
    ]
  }
}
