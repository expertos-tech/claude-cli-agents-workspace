# Template of custom/env/safe-browsing-simulator.env (git-ignored by the custom layer); optional: the defaults work.
# Create it with /local-env tools/safe-browsing-simulator.
# The threats file, relative to tools/safe-browsing-simulator/; empty: the custom layer's
# ../../custom/config/safe-browsing-simulator/threats.json, which must exist. The example: ./config/threats.json
SAFE_BROWSING_THREATS=
