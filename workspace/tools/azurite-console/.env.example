# Template of custom/env/azurite-console.env (git-ignored by the custom layer). Create it with
# /local-env tools/azurite-console, then fill the values (README "How to run"). NEVER put real values here.
# The account key Azurite and the console share; yours, e.g. the output of: openssl rand -base64 48
AZURITE_ACCOUNT_KEY=
# The group that owns the Docker socket, for the access log panel (Linux: stat -c %g /var/run/docker.sock).
DOCKER_SOCKET_GID=
