# Template of custom/env/login-simulator.env (git-ignored by the custom layer); optional: the defaults work.
# Create it with /local-env tools/login-simulator.
# The users and applications file, relative to tools/login-simulator/; empty: the custom layer's
# ../../custom/config/login-simulator/config.json, which must exist. The example: ./config/config.json
LOGIN_SIMULATOR_CONFIG=
