# Template of custom/env/login-simulator.env (git-ignored by the custom layer); optional: the defaults work.
# Create it with /local-env tools/login-simulator.
# The users and applications file, relative to tools/login-simulator/; empty: the example config/config.json.
# The real file lives in the custom layer, e.g. ../../custom/config/login-simulator/config.json
LOGIN_SIMULATOR_CONFIG=
