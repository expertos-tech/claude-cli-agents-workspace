# Template of custom/env/docker-sonar.env, the filled file of the local SonarQube (git-ignored by the custom layer).
# Create or complete it with /local-env docker/sonar (or bash scripts/sync-env.sh --path docker/sonar).
# Local-only values; NEVER put real ones here.
SONAR_DB_PASSWORD=change-me-local-only
# Token generated in the local SonarQube UI (My Account > Security).
SONAR_TOKEN=
