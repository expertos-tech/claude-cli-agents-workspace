# Generated by scripts/setup-claude.sh from rules/agents/ and rules/skills/
.claude/
# State of the hooks and scripts: the check ledger, session numbers, the history.sh queue
.history/
# Independent git repos (see rules/rules.md "Workspace layout")
/projects/*
!/projects/README.md
**/.env
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Scratch files, worktrees and tmp/prompt.md, the default input of /prompt
/tmp/
# The custom layer: a git repo of its own (rules/rules.md "Custom layer")
/custom/
# macOS Finder metadata
.DS_Store
# Local data folders, also skipped by scripts/validate.sh
**/.data/
# Python bytecode
__pycache__/
